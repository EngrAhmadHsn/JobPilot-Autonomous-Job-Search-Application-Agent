APP_NAME=agentic-job-applier
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Job source API keys (optional — for real searches in Phase 3+)
LINKEDIN_API_KEY=
SERPAPI_KEY=
GREENHOUSE_API_KEY=
LEVER_API_KEY=

# Job discovery sources (WS-02) — public board APIs, no keys needed.
# Comma-separated Greenhouse board tokens (boards-api.greenhouse.io) and
# Lever company slugs (api.lever.co). Remotive needs no configuration.
# Examples: GREENHOUSE_BOARDS=stripe,figma / LEVER_COMPANIES=leverdemo
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
JOB_SOURCE_TIMEOUT=15
JOB_SOURCE_MIN_INTERVAL=1.0

# Security / domain allowlist
ALLOWED_DOMAINS=greenhouse.io,lever.co,workday.com,ashbyhq.com,smartrecruiters.com,icims.com

# Browser automation settings
PLAYWRIGHT_HEADLESS=true
BROWSER_ISOLATION=true

# LLM "brain" — the model called from LangGraph nodes (tailoring, research, reasoning).
# LangGraph itself needs no key; this is the engine the nodes invoke.
# Provider examples: google (Gemini — free key: https://aistudio.google.com/app/apikey),
#                    zai (Z.ai GLM), openai, anthropic
LLM_PROVIDER=
LLM_API_KEY=
# Model id per provider, e.g. gemini-3.8-flash, glm-4.6, gpt-4o-mini
LLM_MODEL=
# Optional override for OpenAI-compatible endpoints (e.g. Z.ai: https://api.z.ai/api/paas/v4)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# Optional — LangSmith tracing for LangGraph runs (graph observability/debugging)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-job-applier

# Matching / embeddings (WS-03) — semantic matching via Chroma + Gemini embeddings.
# The embedding model name/dimension are persisted with the vectors; changing
# either requires re-embedding (delete CHROMA_DIR and re-run the upsert).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONALITY=768
CHROMA_DIR=./data/chroma
# Optional — JSON object overriding match component weights (must sum to ~1.0).
# MATCH_WEIGHTS={"semantic":0.2,"skill":0.3,"experience":0.2,"seniority":0.1,"location":0.1,"preference":0.1}
MATCH_WEIGHTS=
