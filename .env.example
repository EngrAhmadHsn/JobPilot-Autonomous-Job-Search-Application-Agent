APP_NAME=agentic-job-applier
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Job discovery sources (WS-02) — public board APIs, NO keys needed.
# Comma-separated Greenhouse board tokens (boards-api.greenhouse.io) and
# Lever company slugs (api.lever.co). Remotive needs no configuration.
# Validated list (probed live 2026-10-11):
#   Greenhouse: stripe(729) cloudflare(424) gitlab(221) anthropic(645)
#     databricks(886) coinbase(222) adyen(239) figma(150) asana(102)
#     airbnb(160) block(231)
#   Lever: palantir(309)
# Not reachable via key-less board APIs (moved off Greenhouse/Ashby):
#   doordash, shopify (own career systems).
# Ashby orgs (adapter FU-2): openai(815), notion(132).
GREENHOUSE_BOARDS=stripe,cloudflare,gitlab,anthropic,databricks,coinbase,adyen,figma,asana,airbnb,block
LEVER_COMPANIES=palantir
ASHBY_ORGS=openai,notion
JOB_SOURCE_TIMEOUT=15
JOB_SOURCE_MIN_INTERVAL=1.0

# Security / domain allowlist (WS-06). Matching is EXACT: a host is allowed when it is
# the domain or a sub-domain of it, so "evil-greenhouse.io.attacker.com" is refused.
# A local host is admitted only when APP_ENV=development (the local fake ATS).
ALLOWED_DOMAINS=greenhouse.io,lever.co,workday.com,ashbyhq.com,smartrecruiters.com,icims.com

# Submission policy (WS-06 · SEC-05). The default requires a recorded human approval
# before any application is executed.
#   PREPARE_ONLY    — prepare and review only; never execute.
#   REQUIRE_APPROVAL — the default: execute only after an approval record exists.
#   AUTO_SUBMIT     — defined but NOT enabled in this version; the API refuses it.
SUBMISSION_POLICY=REQUIRE_APPROVAL

# Evidence artifacts (screenshots, navigation traces, Playwright trace archives) of
# every submission. Defaults to <DATA_DIR>/evidence.
# EVIDENCE_DIR=./data/evidence

# Browser automation settings
PLAYWRIGHT_HEADLESS=true
BROWSER_ISOLATION=true

# LLM "brain" — the model called from LangGraph nodes (tailoring, research, reasoning).
# LangGraph itself needs no key; this is the engine the nodes invoke.
# LLM_PROVIDER selects the adapter:
#   google             — Gemini via the google-genai Interactions API. The default
#                        and the only fully supported path (free key:
#                        https://aistudio.google.com/app/apikey).
#   openai-compatible  — any chat-completions endpoint. EXPERIMENTAL (WS-10).
#   openai / zai       — aliases of openai-compatible, with the vendor's default
#                        base URL (OpenAI / Z.ai GLM). EXPERIMENTAL.
#   anthropic          — not supported: its native API is not chat-completions shaped.
LLM_PROVIDER=
LLM_API_KEY=
# Model id per provider, e.g. gemini-3.8-flash, glm-4.6, gpt-4o-mini
LLM_MODEL=
# Optional override for OpenAI-compatible endpoints (e.g. Z.ai: https://api.z.ai/api/paas/v4)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# LLM resilience (WS-10).
# LLM_TIMEOUT — seconds one provider call may take before it is abandoned.
# LLM_MAX_RPM — calls per minute allowed against the provider. The client paces
#   itself with a sliding-window limiter: it sleeps, it never fails a call.
# LLM_MAX_RETRIES — retries AFTER the first attempt, for a retryable failure
#   (a 429 or a 5xx). 2 means three attempts in total. A bad key, an unknown
#   provider and an invalid response are never retried.
LLM_TIMEOUT=60
LLM_MAX_RPM=10
LLM_MAX_RETRIES=2

# Optional — LangSmith tracing for LangGraph runs (graph observability/debugging)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-job-applier

# Matching / embeddings (WS-03) — semantic matching via Chroma + embeddings.
# EMBEDDING_PROVIDER selects the provider (FU-7):
#   fastembed (default) — EmbeddingGemma-2 runs locally in-process (ONNX, CPU);
#     no API, no quota. Weights download once (~300 MiB) into FASTEMBED_CACHE_PATH.
#   gemini — Gemini embedding API (free-tier RPD 20 x 100-text batches); kept
#     selectable for A/B and fallback.
# The embedding model identity (@variant suffix included) and dimension are
# persisted with the vectors; changing either requires re-embedding (delete
# CHROMA_DIR and re-run the refresh).
EMBEDDING_PROVIDER=fastembed
# Default when provider=fastembed: google/embeddinggemma-2@int8 (fp16 variants
# are forbidden by the model card). Default when provider=gemini: gemini-embedding-2.
# EMBEDDING_MODEL=google/embeddinggemma-2@int8
EMBEDDING_DIMENSIONALITY=768
# Local model-weights cache for the fastembed provider (FU-7). After the first
# download, HF_HUB_OFFLINE=1 makes runs fully offline.
FASTEMBED_CACHE_PATH=./data/fastembed
CHROMA_DIR=./data/chroma
# Optional — JSON object overriding match component weights (must sum to ~1.0).
# MATCH_WEIGHTS={"semantic":0.2,"skill":0.3,"experience":0.2,"seniority":0.1,"location":0.1,"preference":0.1}
MATCH_WEIGHTS=

# Rendered tailored resumes (WS-05). Defaults to <DATA_DIR>/tailored; the
# DOCX deliverable of each tailoring run is written here.
# TAILORED_DIR=./data/tailored
