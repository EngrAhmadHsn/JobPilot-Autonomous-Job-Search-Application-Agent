APP_NAME=agentic-job-applier
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
# The database lives under the gitignored data/ tree. A copy of this file that
# pointed it at ./app.db would put it in the repository root, where it can be
# committed by accident.
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# Job discovery sources (WS-02) — public board APIs, NO keys needed.
# Comma-separated Greenhouse board tokens (boards-api.greenhouse.io) and
# Lever company slugs (api.lever.co). Remotive needs no configuration.
# Validated list (probed live 2026-10-11):
#   Greenhouse: stripe(729) cloudflare(424) gitlab(221) anthropic(645)
#     databricks(886) coinbase(222) adyen(239) figma(150) asana(102)
#     airbnb(160) block(231)
#   Lever: palantir(309)
# Not reachable via key-less board APIs (moved off Greenhouse/Ashby):
#   doordash, shopify (own career systems).
# Ashby orgs (adapter FU-2): openai(815), notion(132).
GREENHOUSE_BOARDS=stripe,cloudflare,gitlab,anthropic,databricks,coinbase,adyen,figma,asana,airbnb,block
LEVER_COMPANIES=palantir
ASHBY_ORGS=openai,notion
JOB_SOURCE_TIMEOUT=15
JOB_SOURCE_MIN_INTERVAL=1.0

# Security / domain allowlist (WS-06). Matching is EXACT: a host is allowed when it is
# the domain or a sub-domain of it, so "evil-greenhouse.io.attacker.com" is refused.
# A local host is admitted only when APP_ENV=development (the local fake ATS).
ALLOWED_DOMAINS=greenhouse.io,lever.co,workday.com,ashbyhq.com,smartrecruiters.com,icims.com

# Submission policy (WS-06 · SEC-05). The default requires a recorded human approval
# before any application is executed.
#   PREPARE_ONLY    — prepare and review only; never execute.
#   REQUIRE_APPROVAL — the default: execute only after an approval record exists.
#   AUTO_SUBMIT     — defined but NOT enabled in this version; the API refuses it.
SUBMISSION_POLICY=REQUIRE_APPROVAL

# Runtime state. Everything the process writes lives under this tree by default,
# and the tree is gitignored.
DATA_DIR=./data
# Evidence artifacts (screenshots, navigation traces, Playwright trace archives)
# of every submission.
EVIDENCE_DIR=./data/evidence
# Uploaded resume files.
RESUME_UPLOAD_DIR=./data/resumes
# Rendered tailored resumes (WS-05) — the DOCX deliverable of each tailoring run.
# Only TAILORED_DIR follows DATA_DIR automatically; if you move DATA_DIR, set
# EVIDENCE_DIR and RESUME_UPLOAD_DIR as well.
TAILORED_DIR=./data/tailored

# Browser automation settings.
# PLAYWRIGHT_HEADLESS — run Chromium without a visible window. Keep it true on a
# server; set it to false on a workstation when you want to watch the browser
# fill the form. It changes nothing about the security controls: the session is
# still a fresh, isolated context per run, and the domain allowlist still
# applies (see docs/SECURITY.md).
PLAYWRIGHT_HEADLESS=true

# LLM "brain" — the model called from LangGraph nodes (tailoring, research, reasoning).
# LangGraph itself needs no key; this is the engine the nodes invoke.
# LLM_PROVIDER selects the adapter:
#   google             — Gemini via the google-genai Interactions API. The default
#                        and the only fully supported path (free key:
#                        https://aistudio.google.com/app/apikey).
#   openai-compatible  — any chat-completions endpoint. EXPERIMENTAL (WS-10).
#   openai / zai       — aliases of openai-compatible, with the vendor's default
#                        base URL (OpenAI / Z.ai GLM). EXPERIMENTAL.
#   anthropic          — not supported: its native API is not chat-completions shaped.
LLM_PROVIDER=
LLM_API_KEY=
# Model id per provider, e.g. gemini-3.8-flash, glm-4.6, gpt-4o-mini
LLM_MODEL=
# Optional override for OpenAI-compatible endpoints (e.g. Z.ai: https://api.z.ai/api/paas/v4)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# LLM resilience (WS-10).
# LLM_TIMEOUT — seconds one provider call may take before it is abandoned.
# LLM_MAX_RPM — calls per minute allowed against the provider. The client paces
#   itself with a sliding-window limiter: it sleeps, it never fails a call.
# LLM_MAX_RETRIES — retries AFTER the first attempt, for a retryable failure
#   (a 429 or a 5xx). 2 means three attempts in total. A bad key, an unknown
#   provider and an invalid response are never retried.
LLM_TIMEOUT=60
LLM_MAX_RPM=10
LLM_MAX_RETRIES=2

# Optional — LangSmith tracing for LangGraph runs (graph observability/debugging)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-job-applier

# Matching / embeddings (WS-03) — semantic matching via Chroma + embeddings.
# EMBEDDING_PROVIDER selects the provider (FU-7):
#   fastembed (default) — EmbeddingGemma-2 runs locally in-process (ONNX, CPU);
#     no API, no quota. Weights download once (~300 MiB) into FASTEMBED_CACHE_PATH.
#   gemini — Gemini embedding API (free-tier RPD 20 x 100-text batches); kept
#     selectable for A/B and fallback.
# The embedding model identity (@variant suffix included) and dimension are
# persisted with the vectors; changing either requires re-embedding (delete
# CHROMA_DIR and re-run the refresh).
EMBEDDING_PROVIDER=fastembed
# Default when provider=fastembed: google/embeddinggemma-2@int8 (fp16 variants
# are forbidden by the model card). Default when provider=gemini: gemini-embedding-2.
# EMBEDDING_MODEL=google/embeddinggemma-2@int8
EMBEDDING_DIMENSIONALITY=768
# Free-tier Gemini embedding quota (AI Studio dashboard, 2026-10-11): RPM 5,
# RPD 20. They apply to the gemini provider; the local provider has no quota.
EMBEDDING_RPM_LIMIT=5
EMBEDDING_RPD_LIMIT=20
# Local model-weights cache for the fastembed provider (FU-7). After the first
# download, HF_HUB_OFFLINE=1 makes runs fully offline.
FASTEMBED_CACHE_PATH=./data/fastembed
CHROMA_DIR=./data/chroma
# Optional — JSON object overriding match component weights (must sum to ~1.0).
# MATCH_WEIGHTS={"semantic":0.2,"skill":0.3,"experience":0.2,"seniority":0.1,"location":0.1,"preference":0.1}
MATCH_WEIGHTS=

# Runtime attack-surface limits (WS-12). Every bound on how much work an
# untrusted caller can cause lives in src/security/limits.py and is read
# from here. An invalid value fails at startup rather than silently
# falling back to a permissive default.
#
# API abuse. The rate limit is per client address (the transport peer, never
# a forwarded header) and its client table is itself bounded.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# The largest request body accepted, in bytes. The resume upload is capped
# at 5 MB of file; this is the envelope around it.
BODY_LIMIT_BYTES=8388608
# How many of the expensive endpoints (the refresh, the search, the
# tailoring) may run at the same time.
MAX_CONCURRENT_HEAVY=2
HEAVY_QUEUE_TIMEOUT_SECONDS=5
# Corpus admission. A single board may not dictate the size of the corpus,
# and the corpus itself is capped — every search reads it.
MAX_LISTINGS_PER_SOURCE=5000
MAX_NEW_LISTINGS_PER_REFRESH=10000
MAX_CORPUS_LISTINGS=50000
# Embedding work. This is the bound that stops a flood of fake listings
# from spending the provider's whole daily quota on texts nobody searches
# for — and with it, the legitimate listings' chance to be embedded.
MAX_EMBED_PER_REFRESH=2000
# The on-disk embedding cache is a permanent table; without a bound it
# grows until the disk is full.
MAX_CACHE_ENTRIES=50000
# Uploads. The 5 MB cap above is on the *compressed* file, so the
# uncompressed size and the entry count are checked too.
MAX_UPLOAD_UNCOMPRESSED_BYTES=52428800
MAX_ZIP_ENTRIES=2000
# The largest response body a job board may return.
MAX_RESPONSE_BYTES=8388608
# Per-request form data.
MAX_CUSTOM_FIELDS=50
MAX_CUSTOM_FIELD_CHARS=2000
# Text bounds. A job posting is not a document.
MAX_DESCRIPTION_CHARS=20000
MAX_TITLE_CHARS=300
MAX_COMPANY_CHARS=200
# The untrusted block in a prompt is capped, so a huge listing cannot blow
# the model's context or the bill.
MAX_PROMPT_UNTRUSTED_CHARS=20000

# -- Identity (WS-14) ---------------------------------------------------------
#
# The API has no anonymous access: a caller is a principal, and the
# principal is what the owner filter is keyed on.
#
# AUTH_SECRET signs the password-reset and e-mail-verification tokens. A
# leaked secret would let an attacker mint a reset token for any account.
# It is NOT the session secret — sessions are server-side rows — but it
# still has to be unguessable. Production refuses to start without one of
# at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# The cookie that carries the session for the browser transport.
AUTH_SESSION_COOKIE_NAME=aja_session
# The double-submit CSRF cookie. It is deliberately NOT HttpOnly: the
# console's JavaScript reads it and echoes it in the X-CSRF-Token header.
# It grants nothing without the session cookie beside it.
AUTH_CSRF_COOKIE_NAME=aja_csrf
# Whether the session cookie carries the Secure attribute. Leave it empty
# to follow the environment: off in development (the development server is
# plain HTTP on localhost), on in production. Setting it to "false" in
# production makes the application refuse to start.
AUTH_COOKIE_SECURE=
# How long a session lives before the server refuses it.
AUTH_SESSION_TTL_SECONDS=86400
# Whether a login requires a verified e-mail address. Off by default:
# this deployment has no SMTP provider, so a verified account could never
# be created. A deployment that sends mail turns it on.
AUTH_REQUIRE_VERIFIED=false
# Whether the first registered account may claim the rows that pre-date
# the identity work (the "legacy" owner). On by default: that is how an
# operator's existing corpus reaches the operator's own account instead
# of being orphaned. The purge in Phase D removes it instead.
AUTH_CLAIM_LEGACY=true
