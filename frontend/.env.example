# The API the console talks to.
#
# Leave it empty in development: the Vite dev server proxies `/api` to
# http://127.0.0.1:8000, so the browser makes a same-origin request and the
# CORS configuration is not load-bearing (see `vite.config.ts`).
#
# Set it to an absolute URL to talk to a backend somewhere else:
#   VITE_API_BASE_URL=https://api.example.com
#
# There is no secret here. The console holds no credential: the session is
# an `HttpOnly` cookie the browser attaches on its own, and the only token
# the console can read is the CSRF token, which grants nothing without that
# cookie beside it. Nothing in this file may ever be a key.
VITE_API_BASE_URL=

# Where the dev proxy forwards the API calls. Development-time only.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
