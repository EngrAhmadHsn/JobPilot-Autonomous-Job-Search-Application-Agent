' The shared style for every diagram in this folder.
'
' It matches the typography of the Software Design Document: one serif face, a
' white page, a black border and no drop shadow, so a diagram and a page of
' prose look like they came from the same document.
'
' The sources are ASCII only. PlantUML reads them with the platform default
' encoding, which is Cp1252 on this machine, so a non-ASCII character would
' change meaning rather than merely look different.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam ArrowColor #000000
skinparam ArrowFontName "Times New Roman"
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.2
skinparam LineColor #000000
skinparam LineThickness 1.2

skinparam packageStyle rectangle
skinparam packageFontName "Times New Roman"
skinparam packageFontSize 13
skinparam packageBorderColor #000000
skinparam packageBackgroundColor #FFFFFF

skinparam componentStyle rectangle
skinparam componentFontName "Times New Roman"
skinparam componentFontSize 13
skinparam componentBorderColor #000000
skinparam componentBackgroundColor #FFFFFF

skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam classFontName "Times New Roman"
skinparam classFontSize 13
skinparam classFontColor #000000
skinparam classHeaderBackgroundColor #EFEFEF
skinparam classStereotypeFontColor #000000
skinparam classAttributeFontStyle plain
skinparam classMethodFontStyle plain
skinparam classFontStyle bold
skinparam entityAttributeIconSize 0
skinparam entityBackgroundColor #FFFFFF
skinparam entityBorderColor #000000
skinparam entityFontName "Times New Roman"
skinparam entityFontSize 12
skinparam entityFontColor #000000
skinparam entityHeaderBackgroundColor #EFEFEF
skinparam entityStereotypeFontColor #000000

skinparam objectAttributeIconSize 0
skinparam objectBackgroundColor #FFFFFF
skinparam objectBorderColor #000000
skinparam objectFontName "Times New Roman"
skinparam objectFontSize 12
skinparam objectFontColor #000000
skinparam objectHeaderBackgroundColor #EFEFEF

skinparam stateFontName "Times New Roman"
skinparam stateFontSize 13
skinparam stateBackgroundColor #FFFFFF
skinparam stateBorderColor #000000
skinparam startStateFontName "Times New Roman"
skinparam endStateFontName "Times New Roman"

skinparam activityFontName "Times New Roman"
skinparam activityFontSize 13
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #000000
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #000000

skinparam participantFontName "Times New Roman"
skinparam participantFontSize 12
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #000000
skinparam actorFontName "Times New Roman"
skinparam actorFontSize 12
skinparam sequenceFontName "Times New Roman"
skinparam sequenceFontSize 11
skinparam sequenceGroupFontSize 11
skinparam sequenceLifeLineBorderColor #000000
skinparam sequenceGroupBorderColor #000000
skinparam sequenceGroupBackgroundColor #FFFFFF

skinparam usecaseFontName "Times New Roman"
